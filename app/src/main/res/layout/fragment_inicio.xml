<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.FragmentInicio"
    android:background="@color/gris_Clarito">

    <LinearLayout
        android:id="@+id/busqueda_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        >

        <EditText
            android:id="@+id/main_ET"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Introduzca respuesta"
            android:inputType="text"
            android:textColor="@color/cremoso"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"

            />

        <Button
            android:id="@+id/boton_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"
            android:backgroundTint="@color/naranja_cobre"
            />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_anime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/busqueda_main"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="1"
        android:layout_marginTop="10dp"
        tools:itemCount="5"
        tools:listitem="@layout/vw_elemento"

        />
    <TextView
        android:id="@+id/text_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/recycler_anime"
        app:layout_constraintTop_toBottomOf="@id/recycler_anime"
        android:textSize="50sp"
        android:textColor="@color/cremoso"
        android:textStyle="bold"
        android:text="Cargando..."
        />

</RelativeLayout>